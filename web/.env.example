# 全部留空 → 本機示範模式（PGlite 存在 web/.data/pglite，登入改選示範使用者；AI 用 mock provider）
# 下面三個要「一起」設定才會切到 Supabase；只設一半會直接報錯，避免誤寫到本機資料庫。

# Supabase 專案的 URL 與 publishable key（舊專案可改用 NEXT_PUBLIC_SUPABASE_ANON_KEY）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres 連線字串：用 Supabase「Connect」裡的 Transaction pooler（port 6543）
# 程式只用它來連資料庫；個人資料的請求內會切換成 authenticated 角色，RLS 照樣生效
DATABASE_URL=

# AI：mock（預設，固定範例內容、不需要金鑰）或 gemini（Google AI Studio 免費方案）
AI_PROVIDER=mock
# AI_PROVIDER=gemini 時必填；到 https://aistudio.google.com 建立金鑰。只在伺服器使用，不會進 client bundle。
GEMINI_API_KEY=
# 選填：預設 gemini-3.6-flash（免費方案，實測約 12 秒生成一頁）；3.8-flash 在免費方案常過載
# GEMINI_MODEL=gemini-3.6-flash
# 選填：主要模型 503 過載時改用的模型（預設 gemini-3.5-flash-lite；設成空字串表示不換）
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# 選填：思考量 minimal／low／medium／high（預設 low：免費方案速度與品質的折衷）
# GEMINI_THINKING=low

# 選填
# AI_HOURLY_LIMIT=20                # 每位使用者每小時最多呼叫 AI 的次數
# DATABASE_POOL_MAX=5
# PGLITE_DATA_DIR=.data/pglite      # 本機示範資料的位置；memory:// 表示不存檔
# DK_LOCAL_MODE=1                   # 只有本機用 next start 示範時才需要
